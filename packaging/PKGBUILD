# Maintainer: TODO <you@example.com>
# Builds Truecast from the tagged source tarball.
#
# The source tag `v$pkgver` must exist before this builds.

pkgname=truecast
pkgver=0.1.3
pkgrel=1
pkgdesc="A weather app that proves its numbers — macOS-style, for Linux"
arch=('x86_64')
url="https://github.com/tarun-bansal/truecast"
license=('MIT')
depends=('gtk3' 'nss' 'libxss' 'libasound2' 'libgbm' 'libsecret')
makedepends=('nodejs' 'npm')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  npm ci
  npm run build
  npx electron-builder --linux dir --publish never
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -d "$pkgdir/opt/truecast"
  cp -r release/linux-unpacked/. "$pkgdir/opt/truecast/"
  install -Dm644 packaging/truecast.desktop "$pkgdir/usr/share/applications/truecast.desktop"
  install -Dm644 build/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/truecast.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
