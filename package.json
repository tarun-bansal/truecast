{
  "name": "truecast",
  "private": true,
  "version": "0.1.2",
  "description": "A weather app that proves its numbers — macOS-style, for Linux.",
  "homepage": "https://github.com/tarun-bansal/truecast",
  "author": "Tarun Bansal",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron:dev": "tsc -p tsconfig.electron.json && electron .",
    "build": "tsc -p tsconfig.electron.json && tsc -b && vite build",
    "electron:build": "electron-builder --publish never",
    "dist": "npm run build && npm run electron:build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "concurrently": "^9.0.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.3.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.truecast.weather",
    "productName": "Truecast",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Weather",
      "maintainer": "tarun-bansal",
      "description": "macOS-like Weather app for Ubuntu",
      "icon": "build/icon.png",
      "desktop": {
        "entry": {
          "StartupWMClass": "truecast"
        }
      },
      "syncDesktopName": true
    },
    "deb": {
      "compression": "xz"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tarun-bansal/truecast.git"
  },
  "bugs": {
    "url": "https://github.com/tarun-bansal/truecast/issues"
  },
  "license": "MIT",
  "desktopName": "truecast.desktop"
}
